{
  "name": "llm-game-arena",
  "version": "0.2.0",
  "description": "CLI players for LLM Game Arena",
  "license": "MIT",
  "keywords": [
    "chess",
    "llm",
    "codex",
    "claude",
    "ollama",
    "openrouter"
  ],
  "type": "module",
  "bin": {
    "llm-game-arena": "dist/index.js",
    "chess-player": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filipenos/llm-game-arena.git",
    "directory": "apps/player-cli"
  },
  "homepage": "https://chess.filipenos.com",
  "bugs": "https://github.com/filipenos/llm-game-arena/issues",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup --config tsup.config.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsup": "latest"
  }
}
